<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:fitsSystemWindows="true"
        app:liftOnScroll="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationIconTint="@color/textPrimary"
            app:title="@string/title_activity_sticker_pack_info"
            app:titleCentered="true"
            app:titleTextColor="@color/textPrimary" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.gms.ads.AdView
                android:id="@+id/adView10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                ads:adSize="BANNER"
                ads:adUnitId="ca-app-pub-6979979912689100/9787919706" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tray_icon"
                        style="@style/InfoButtonStyle"
                        android:layout_marginTop="0dp"
                        android:clickable="false"
                        android:paddingTop="20dp"
                        android:paddingBottom="20dp"
                        android:text="@string/info_screen_tray_icon"
                        android:textColor="@color/textSecondary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        android:letterSpacing="0.05" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="24dp"
                        android:layout_marginEnd="24dp"
                        android:background="@color/divider" />

                    <TextView
                        android:id="@+id/view_webpage"
                        style="@style/InfoButtonStyle"
                        android:layout_marginTop="0dp"
                        android:drawableStart="@drawable/sticker_3rdparty_web"
                        android:drawablePadding="24dp"
                        android:paddingTop="20dp"
                        android:paddingBottom="20dp"
                        android:text="@string/view_webpage"
                        android:textColor="@color/textPrimary"
                        android:textSize="16sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="64dp"
                        android:layout_marginEnd="24dp"
                        android:background="@color/divider" />

                    <TextView
                        android:id="@+id/send_email"
                        style="@style/InfoButtonStyle"
                        android:layout_marginTop="0dp"
                        android:drawableStart="@drawable/sticker_3rdparty_email"
                        android:drawablePadding="24dp"
                        android:paddingTop="20dp"
                        android:paddingBottom="20dp"
                        android:text="@string/send_email"
                        android:textColor="@color/textPrimary"
                        android:textSize="16sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="64dp"
                        android:layout_marginEnd="24dp"
                        android:background="@color/divider" />

                    <TextView
                        android:id="@+id/privacy_policy"
                        style="@style/InfoButtonStyle"
                        android:layout_marginTop="0dp"
                        android:drawableStart="@drawable/sticker_3rdparty_privacy"
                        android:drawablePadding="24dp"
                        android:paddingTop="20dp"
                        android:paddingBottom="20dp"
                        android:text="@string/privacy_policy"
                        android:textColor="@color/textPrimary"
                        android:textSize="16sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="64dp"
                        android:layout_marginEnd="24dp"
                        android:background="@color/divider" />

                    <TextView
                        android:id="@+id/license_agreement"
                        style="@style/InfoButtonStyle"
                        android:layout_marginTop="0dp"
                        android:drawableStart="@drawable/sticker_3rdparty_license"
                        android:drawablePadding="24dp"
                        android:paddingTop="20dp"
                        android:paddingBottom="20dp"
                        android:text="@string/license_agreement"
                        android:textColor="@color/textPrimary"
                        android:textSize="16sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.gms.ads.AdView
                android:id="@+id/adView1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                ads:adSize="BANNER"
                ads:adUnitId="ca-app-pub-6979979912689100/6856886061" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>