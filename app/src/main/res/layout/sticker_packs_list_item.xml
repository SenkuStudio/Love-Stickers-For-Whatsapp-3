<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sticker_store_row_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:rippleColor="@color/rippleColor"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/sticker_pack_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toStartOf="@id/favorite_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/sticker_pack_title"
                style="@style/sticker_packs_list_item_title_style"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:textColor="@color/textPrimary"
                tools:text="Pusheen" />


            <ImageView
                android:id="@+id/sticker_pack_animation_indicator"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/sticker_pack_animation_indicator"
                android:src="@drawable/animated_pack_indicator"
                app:tint="@color/colorPrimary" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/sticker_pack_meta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toStartOf="@id/favorite_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/sticker_pack_info">

            <TextView
                android:id="@+id/sticker_pack_publisher"
                style="@style/sticker_packs_list_item_author_style"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="150dp"
                tools:text="petellison" />

            <TextView
                android:id="@+id/sticker_pack_list_item_dot"
                style="@style/sticker_packs_list_item_author_style"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/dot"
                android:visibility="gone" />

            <TextView
                android:id="@+id/sticker_pack_filesize"
                style="@style/sticker_packs_list_item_author_style"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:text="700kb" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/sticker_packs_list_item_image_list"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/sticker_pack_meta">

            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/sticker_img_1"
                style="@style/sticker_packs_list_item_image_style"
                android:layout_width="@dimen/sticker_pack_list_item_preview_image_size"
                android:layout_height="@dimen/sticker_pack_list_item_preview_image_size"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/sticker_img_2"
                style="@style/sticker_packs_list_item_image_style"
                android:layout_width="@dimen/sticker_pack_list_item_preview_image_size"
                android:layout_height="@dimen/sticker_pack_list_item_preview_image_size"
                android:layout_marginStart="8dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/sticker_img_3"
                style="@style/sticker_packs_list_item_image_style"
                android:layout_width="@dimen/sticker_pack_list_item_preview_image_size"
                android:layout_height="@dimen/sticker_pack_list_item_preview_image_size"
                android:layout_marginStart="8dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/sticker_img_4"
                style="@style/sticker_packs_list_item_image_style"
                android:layout_width="@dimen/sticker_pack_list_item_preview_image_size"
                android:layout_height="@dimen/sticker_pack_list_item_preview_image_size"
                android:layout_marginStart="8dp"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/favorite_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:src="@drawable/ic_favorite_border"
            app:layout_constraintBottom_toBottomOf="@id/sticker_pack_meta"
            app:layout_constraintEnd_toStartOf="@id/add_button_on_list"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/colorPrimary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/add_button_on_list"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:icon="@drawable/sticker_3rdparty_add"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="28dp"
            app:iconTint="@color/colorPrimary"
            app:layout_constraintBottom_toBottomOf="@id/sticker_pack_meta"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:rippleColor="@color/rippleColor" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
