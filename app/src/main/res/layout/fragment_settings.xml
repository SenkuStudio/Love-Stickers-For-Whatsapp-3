<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/settings_theme"
            android:textColor="@color/colorPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settings_light_theme"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:text="@string/settings_light_theme"
            android:textColor="@color/textPrimary"
            app:icon="@drawable/ic_theme_light"
            app:iconTint="@color/textSecondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settings_dark_theme"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:text="@string/settings_dark_theme"
            android:textColor="@color/textPrimary"
            app:icon="@drawable/ic_theme_dark"
            app:iconTint="@color/textSecondary" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@color/colorPrimary"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stickify Premium"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Remove all ads and get exclusive animated stickers."
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_go_premium"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Upgrade Now"
                    android:textAllCaps="false"
                    android:textColor="@color/colorPrimary"
                    app:backgroundTint="@android:color/white"
                    app:cornerRadius="20dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:background="@color/divider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/settings_app"
            android:textColor="@color/colorPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settings_how_to_use"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:text="@string/nav_how_to_use"
            android:textColor="@color/textPrimary"
            app:icon="@android:drawable/ic_menu_help"
            app:iconTint="@color/textSecondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settings_share"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:text="@string/nav_share"
            android:textColor="@color/textPrimary"
            app:icon="@android:drawable/ic_menu_share"
            app:iconTint="@color/textSecondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settings_rate"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:text="@string/nav_rate"
            android:textColor="@color/textPrimary"
            app:icon="@android:drawable/btn_star_big_on"
            app:iconTint="@color/textSecondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settings_more_apps"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:text="@string/nav_more_apps"
            android:textColor="@color/textPrimary"
            app:icon="@android:drawable/ic_menu_agenda"
            app:iconTint="@color/textSecondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settings_contact_us"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:text="@string/nav_contact_us"
            android:textColor="@color/textPrimary"
            app:icon="@android:drawable/ic_menu_send"
            app:iconTint="@color/textSecondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settings_request_sticker"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:text="Request a Sticker"
            android:textColor="@color/textPrimary"
            app:icon="@android:drawable/ic_menu_add"
            app:iconTint="@color/textSecondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settings_clear_cache"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:text="@string/settings_clear_cache"
            android:textColor="@color/textPrimary"
            app:icon="@android:drawable/ic_menu_delete"
            app:iconTint="@color/textSecondary" />

        <!--
        <com.google.android.material.button.MaterialButton
            android:id="@+id/settings_ad_inspector"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:text="Open Ad Inspector"
            android:textColor="@color/textPrimary"
            app:icon="@android:drawable/ic_menu_info_details"
            app:iconTint="@color/textSecondary" />
        -->

        <FrameLayout
            android:id="@+id/native_ad_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>